{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for main and mini-player windows",
  "windows": [
    "main",
    "mini-player",
    "vsk_context_menu"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "vicons:default",
    "config-manager:default",
    "store:default",
    "vsk-contextual-menu:default",
    "vsk-journal:default",
    "i18n:allow-load-translations",
    "i18n:allow-get-available-locales",
    "i18n:allow-get-locale",
    "i18n:allow-set-locale",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text"
  ]
}
