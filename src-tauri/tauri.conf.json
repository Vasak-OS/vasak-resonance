{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vasak-resonance",
  "version": "0.2.0",
  "identifier": "ar.net.vasak.resonance",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Resonance",
        "width": 1400,
        "height": 700,
        "decorations": false,
        "transparent": true
      },
      {
        "label": "mini-player",
        "title": "MiniPlayer - Resonance",
        "width": 360,
        "height": 120,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost blob:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },
      "deb": {
        "desktopTemplate": "vasak-resonance.desktop.hbs",
        "depends": [
          "libcairo2",
          "desktop-file-utils",
          "libgdk-pixbuf-2.0-0",
          "libglib2.0-0t64",
          "libgtk-3-0t64",
          "hicolor-icon-theme",
          "libsoup2.4-1",
          "libsoup-3.0-0",
          "libpango-1.0-0",
          "libwebkit2gtk-4.1-0",
          "sqlite3",
          "dbus"
        ],
        "files": {}
      }
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}
